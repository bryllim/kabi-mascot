{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:site",
  "outputDirectory": "site",
  "cleanUrls": false,
  "redirects": [{ "source": "/", "destination": "/web/", "permanent": false }],
  "headers": [
    { "source": "/(.*)\\.riv", "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }] },
    { "source": "/(.*)\\.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] }
  ]
}
